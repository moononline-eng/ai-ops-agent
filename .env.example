# Copy to .env and fill in. Never commit .env.

# Required: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# What the agent may do: report | issue | pr
AGENT_MODE=report
# true = decide everything, call nothing external (GitHub writes are only logged)
AGENT_DRY_RUN=true

# Model + effort (claude-opus-5-5 default; claude-sonnet-5-5 is cheaper)
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high

# Budgets
AGENT_MAX_FINDINGS_PER_RUN=5
AGENT_MAX_TOOL_CALLS_PER_FINDING=12
AGENT_MAX_INPUT_TOKENS_PER_RUN=400000
AGENT_MAX_GITHUB_WRITES_PER_RUN=3
AGENT_MIN_CONFIDENCE_FOR_PR=0.8

# GitHub (only for issue/pr mode with AGENT_DRY_RUN=false)
# Fine-grained PAT, ONE repository, permissions: Issues RW, Pull requests RW, Contents RW, Metadata R
AGENT_GITHUB_REPO=your-user/your-test-repo
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_BASE_BRANCH=main
