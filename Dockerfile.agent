FROM python:3.12-slim
# git is only used for `git apply` on a scratch copy; nothing is ever pushed with it.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /agent
COPY pyproject.toml ./
COPY agent ./agent
COPY demo_app ./demo_app
RUN pip install --no-cache-dir ".[dev]"
# Run as an unprivileged user; it only needs to write to /data.
RUN useradd --create-home agent && mkdir -p /data && chown agent /data
USER agent
WORKDIR /data
ENV AGENT_LOG_FILE=/logs/app.jsonl \
    AGENT_REPO_ROOT=/repo \
    AGENT_STATE_FILE=/data/state.json \
    AGENT_REPORTS_DIR=/data/reports \
    AGENT_AUDIT_FILE=/data/audit/audit.jsonl
ENTRYPOINT ["python", "-m", "agent"]
CMD ["run"]
